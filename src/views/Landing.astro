---
// The whole site: who I am, and where to find the rest.
import Page from '../layouts/Page.astro';
import Wordmark from '../components/Wordmark.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const otherLang = t.lang === 'en' ? 'pt-BR' : 'en';
const external = (href: string) => href.startsWith('http');
---
<Page t={t}>
  <div class="sheet">
    <header class="wrap top">
      <a class="top-wm" href={t.paths.home} aria-label="castelli"><Wordmark tone="ink" /></a>
      <a class="top-lang" href={t.paths.other} hreflang={otherLang} lang={otherLang} aria-label={t.otherName}>{t.otherLabel}</a>
    </header>

    <main id="main" class="wrap main">
      <h1 class="name">
        <span>{t.name}</span><span class="name-stain" aria-hidden="true" data-stain-load>{t.name}</span>
      </h1>

      <div class="bio">
        {t.bio.map((p) => <p>{p}</p>)}
      </div>

      <ul class="lines">
        {t.lines.map((l) => (
          <li>
            {l.before}{l.links.map((k, i) => (
              <>{i > 0 && l.join}<a href={k.href} rel={external(k.href) ? 'me' : undefined}>{k.label}</a></>
            ))}{l.after}
          </li>
        ))}
      </ul>
    </main>

    <footer class="wrap base">
      <p>{t.copy}</p>
    </footer>
  </div>
</Page>

<style>
  .sheet {
    --blue: #9C9CFF;
    min-height: 100vh; min-height: 100dvh;
    display: grid; grid-template-rows: auto 1fr auto;
    background: var(--c-ink); color: var(--c-raised);
    border-top: 6px solid var(--c-ultramarine);
  }

  .top { display: flex; justify-content: space-between; align-items: center; min-height: 76px; }
  .top-wm { font-size: 26px; text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
  .top-lang { font-weight: 600; font-size: 15px; text-decoration: none; color: #B9B6AE; min-height: 44px; display: inline-flex; align-items: center; }
  .top-lang:hover { color: var(--blue); }

  .main { display: grid; gap: 40px; align-content: center; padding-block: clamp(48px, 8vw, 120px); }

  .name { position: relative; justify-self: start; font-family: var(--font-display); font-weight: 700; font-size: var(--t-h1); line-height: 0.98; letter-spacing: -0.035em; }
  .name-stain { position: absolute; inset: 0; color: var(--c-fluorescein); clip-path: inset(0 100% 0 0); pointer-events: none; }

  .bio { display: grid; gap: 16px; max-width: 58ch; color: #B9B6AE; font-size: var(--t-lead); line-height: 1.5; }

  .lines { list-style: none; display: grid; border-top: 1px solid #3A3833; max-width: 900px; }
  .lines li {
    position: relative; padding: 18px 0 18px 24px; border-bottom: 1px solid #3A3833;
    font-family: var(--font-display); font-weight: 600; font-size: var(--t-h3); line-height: 1.25; letter-spacing: -0.02em;
  }
  .lines li::before { content: ""; position: absolute; left: 0; top: calc(18px + 0.625em); width: 8px; height: 8px; background: var(--c-ultramarine); transform: translateY(-50%); }
  .lines a { text-decoration-line: underline; text-decoration-color: var(--c-fluorescein); text-decoration-thickness: 2px; text-underline-offset: 0.18em; overflow-wrap: anywhere; }
  .lines a:hover { color: var(--blue); text-decoration-color: var(--blue); }

  .base { padding-block: 24px 32px; border-top: 1px solid #3A3833; font-size: 14px; color: #B9B6AE; }
</style>
