---
import Sheet from '../layouts/Sheet.astro';
import Fig1 from '../components/Fig1.astro';
import Work from '../components/Work.astro';
import Fig3 from '../components/Fig3.astro';
import Contact from '../components/Contact.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
---
<Sheet t={t} page="home">
  <Fig1 t={t} />
  <Work t={t} />
  <Fig3 t={t} />
  <Contact t={t} />
</Sheet>
<script>
  import '../scripts/reveal.ts';
</script>
