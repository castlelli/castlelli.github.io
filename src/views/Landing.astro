---
import Page from '../layouts/Page.astro';
import Film from '../components/Film.astro';
import Work from '../components/Work.astro';
import Research from '../components/Research.astro';
import Proof from '../components/Proof.astro';
import Contact from '../components/Contact.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
---
<Page t={t} page="home" dark>
  <Film t={t} />
  <Work t={t} />
  <Research t={t} />
  <Proof t={t} />
  <Contact t={t} />
</Page>
