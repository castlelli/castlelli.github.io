---
// A project page, set as a short journal article: title, abstract, figure,
// body, methods, links.
import { render, type CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import Figure from '../components/Figure.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict; entry: CollectionEntry<'work'> }
const { t, entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const w = t.work;
const work = (home: string) => `${home}work/${d.slug}/`;
const paths = { self: work(t.paths.home), other: work(t.paths.other) };
const [primary, ...more] = d.links;
import Arrow from '../components/Arrow.astro';
---
<Page t={{ ...t, meta: { ...t.meta, title: `${d.title} · Vinicius Castelli`, description: d.summary } }} page="work" paths={paths}>
  <article class="art wrap">
    <a class="link-quiet art-back" href={`${t.paths.home}#work`}><Arrow dir="left" /> {w.contents}</a>

    <header class="art-head">
      <h1 class="art-t">{d.title}</h1>
      <p class="art-abs">{d.summary}</p>
      <dl class="art-meta">
        <div><dt>{w.role}</dt><dd>{d.role}</dd></div>
        <div><dt>{w.dates}</dt><dd>{d.dates}</dd></div>
        <div><dt>{w.status}</dt><dd>{d.status}</dd></div>
        {d.dims.map((m) => <div><dt>{m.label}</dt><dd>{m.value} {m.unit}</dd></div>)}
      </dl>
    </header>

    <figure class="art-fig">
      <div class="plate art-plate" style={`view-transition-name: plate-${d.slug}`}><Figure t={t} figure={d.figure} /></div>
      {d.figure && <figcaption class="figcap"><b>{t.ui.fig} 1.</b> {w.figs[d.figure].caption}</figcaption>}
    </figure>

    <div class="art-body">
      <div class="art-prose"><Content /></div>
      <aside class="art-side">
        {d.stack.length > 0 && (
          <section>
            <h2 class="art-h">{w.stack}</h2>
            <p class="art-stack">{d.stack.join(', ')}</p>
          </section>
        )}
        {d.links.length > 0 && (
          <p class="art-links">
            <a class="go" href={primary.href}>{primary.label} <Arrow dir="out" /></a>
            {more.map((l) => <a class="link-quiet" href={l.href}>{l.label} <Arrow dir="out" /></a>)}
          </p>
        )}
      </aside>
    </div>
  </article>
</Page>

<style>
  .art { display: grid; gap: clamp(40px, 5vw, 72px); padding-block: clamp(32px, 4vw, 56px) var(--section); }
  .art-back { color: var(--muted); justify-self: start; }
  .art-back:hover { color: var(--fg); }
  .art-head { display: grid; gap: 24px; max-width: 900px; }
  .art-t { font-weight: 600; font-size: clamp(44px, 5.6vw, 80px); line-height: 1; letter-spacing: -0.025em; text-wrap: balance; }
  .art-abs { font-style: italic; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.4; color: var(--muted); max-width: 46ch; }
  .art-meta { display: flex; flex-wrap: wrap; gap: 10px 40px; padding-top: 18px; border-top: 1.5px solid var(--c-tinta); font: 15px var(--font-sans); }
  .art-meta dt { font-size: 13px; color: var(--muted); }
  .art-meta dt::first-letter { text-transform: uppercase; }
  .art-fig { min-width: 0; }
  .art-plate { padding: clamp(20px, 4.5vw, 72px); }
  .art-body { display: grid; gap: 48px; }
  .art-prose { max-width: 62ch; }
  .art-prose :global(p + p) { margin-top: 1em; }
  .art-prose :global(p:first-child::first-line) { font-variant-caps: all-small-caps; letter-spacing: 0.04em; }
  .art-side { display: grid; gap: 36px; align-content: start; }
  .art-h { font: 500 14px var(--font-sans); color: var(--muted); padding-bottom: 10px; border-bottom: 1px solid var(--rule); margin-bottom: 14px; }
  .art-stack { font-size: 17px; line-height: 1.6; }
  .art-links { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
  @media (min-width: 1000px) { .art-body { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(56px, 7vw, 112px); } }
</style>
