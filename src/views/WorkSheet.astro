---
// A project page: ultramarine title band, the live site's screenshot, the story,
// and the way out to the real thing.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import ToolList from '../components/ToolList.astro';
import Arrow from '../components/Arrow.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict; entry: CollectionEntry<'work'> }
const { t, entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const u = t.ui;
const work = (home: string, slug: string) => `${home}work/${slug}/`;
const paths = { self: work(t.paths.home, d.slug), other: work(t.paths.other, d.slug) };
const all = (await getCollection('work', (e) => e.data.lang === t.lang)).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((e) => e.data.slug === d.slug);
const prev = all[(i - 1 + all.length) % all.length].data;
const next = all[(i + 1) % all.length].data;
---
<Page t={t} page="work" paths={paths} title={`${d.title} · Vinicius Castelli`} description={d.summary}>
  <div class="progress" data-progress hidden aria-hidden="true"></div>
  <article>
    <header class="band case-hd">
      <div class="wrap case-hd-in">
        <a class="link case-back" href={`${t.paths.home}#work`}><Arrow dir="left" /> {u.backToWork}</a>
        <h1 class="h1" style={`view-transition-name: title-${d.slug}`}>{d.title}</h1>
        <p class="lead case-sum">{d.summary}</p>
        <dl class="case-meta">
          <div><dt>{u.role}</dt><dd>{d.role}</dd></div>
          <div><dt>{u.dates}</dt><dd>{d.dates}</dd></div>
          <div><dt>{u.status}</dt><dd>{d.status}</dd></div>
        </dl>
        <a class="btn case-go" href={d.site.href}>{u.visit} {d.site.label} <Arrow dir="out" /></a>
      </div>
    </header>

    <figure class="wrap case-fig">
      <a href={d.site.href} tabindex="-1" aria-hidden="true">
        <img src={`${d.image}-1600.webp`} srcset={`${d.image}-800.webp 800w, ${d.image}-1600.webp 1600w`} sizes="(min-width: 1424px) 1280px, calc(100vw - 32px)" alt={d.imageAlt} width="1600" height="1000" fetchpriority="high" decoding="async" />
      </a>
    </figure>

    <div class="wrap case-body">
      <div class="case-prose"><Content /></div>
      <aside class="case-side">
        {d.stack.length > 0 && (
          <section>
            <h2 class="case-h">{u.stack}</h2>
            <p>{d.stack.join(', ')}</p>
          </section>
        )}
        {d.links.length > 0 && (
          <section>
            <h2 class="case-h">{u.links}</h2>
            <ul class="case-links">{d.links.map((l) => <li><a class="link" href={l.href}>{l.label} <Arrow dir="out" /></a></li>)}</ul>
          </section>
        )}
      </aside>
    </div>

    {d.kind === 'collection' && d.items.length > 0 && (
      <section class="wrap case-tools" aria-labelledby="tools-h">
        <h2 class="h2" id="tools-h">{u.tools}</h2>
        <ToolList t={t} items={d.items} />
      </section>
    )}

    <nav class="wrap case-nav" aria-label={t.ui.work}>
      <a href={work(t.paths.home, prev.slug)}><span>{u.prev}</span><b class="h3">{prev.title}</b></a>
      <a href={work(t.paths.home, next.slug)} class="case-next"><span>{u.next}</span><b class="h3">{next.title}</b></a>
    </nav>
  </article>
</Page>

<style>
  .progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 60; background: var(--c-fluorescein); box-shadow: 0 1px 0 var(--c-ink); transform-origin: 0 50%; transform: scaleX(0); }
  .case-hd-in { display: grid; gap: 22px; justify-items: start; padding-block: clamp(16px, 3vw, 32px) clamp(120px, 14vw, 200px); }
  .case-back { color: var(--on-band-muted); text-decoration: none; }
  .case-back:hover { color: var(--on-band); }
  .case-hd h1 { max-width: 16ch; }
  .case-sum { max-width: 42ch; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 12px 44px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.4); width: 100%; font-size: 15px; }
  .case-meta dt { font-size: 13px; color: var(--on-band-muted); }
  .case-meta dd { max-width: 34ch; }
  .case-go { margin-top: 6px; }

  /* the screenshot overlaps the band's lower edge */
  .case-fig { margin-top: clamp(-170px, -12vw, -96px); position: relative; }
  .case-fig a { display: block; background: var(--surface); box-shadow: 0 24px 60px -20px rgba(20, 19, 18, 0.45); outline: 1px solid rgba(20, 19, 18, 0.12); outline-offset: -1px; }
  .case-fig img { width: 100%; height: auto; }

  .case-body { display: grid; gap: 48px; padding-block: clamp(56px, 7vw, 104px); }
  .case-prose { display: grid; gap: 1em; max-width: 66ch; font-size: 18px; line-height: 1.6; }
  .case-prose :global(p:first-child) { font-size: var(--t-lead); line-height: 1.45; }
  .case-side { display: grid; gap: 32px; align-content: start; }
  .case-h { font-size: 14px; font-weight: 600; color: var(--muted); padding-bottom: 10px; border-bottom: 1px solid var(--rule); margin-bottom: 12px; }
  .case-links { list-style: none; }
  .case-links .link { color: var(--accent); }
  @media (min-width: 1000px) { .case-body { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(56px, 7vw, 112px); } }

  .case-tools { display: grid; gap: 28px; padding-bottom: var(--section); }

  .case-nav { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule-strong); margin-bottom: var(--section); }
  .case-nav a { display: grid; gap: 6px; padding: 24px 0; text-decoration: none; }
  .case-nav a span { font-size: 14px; color: var(--muted); }
  .case-nav a:hover b { color: var(--accent); }
  .case-next { text-align: right; border-left: 1px solid var(--rule); padding-left: 20px !important; }
</style>
