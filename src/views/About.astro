---
// The one pager, set as a curriculum vitae in the journal's style.
import Page from '../layouts/Page.astro';
import Contact from '../components/Contact.astro';
import Photo from '../components/Photo.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const a = t.about;
const s = a.sections;
import Arrow from '../components/Arrow.astro';
---
<Page t={t} page="about">
  <article class="cv wrap">
    <a class="link-quiet cv-back" href={t.paths.home}><Arrow dir="left" /> {a.back}</a>

    <header class="cv-head">
      <div>
        <h1 class="display">{a.title}</h1>
        <p class="cv-sub">{a.subtitle}</p>
      </div>
      <figure class="cv-fig">
        <Photo name="portrait" alt={a.title} fallback="mark" class="cv-plate" />
        <figcaption class="figcap"><b>{t.ui.fig} 1.</b> {a.figCaption}</figcaption>
      </figure>
    </header>

    <div class="cv-cols">
      <section class="cv-sec" aria-labelledby="cv-about">
        <h2 class="cv-h" id="cv-about">{s.description}</h2>
        <div class="cv-prose">{a.description.map((p) => <p>{p}</p>)}</div>
      </section>
      <section class="cv-sec" aria-labelledby="cv-do">
        <h2 class="cv-h" id="cv-do">{s.features}</h2>
        <ul class="cv-list">{a.features.map((f) => <li>{f}</li>)}</ul>
      </section>
    </div>

    <section class="cv-sec" aria-labelledby="cv-op">
      <h2 class="cv-h" id="cv-op">{s.operating}</h2>
      <div class="table-scroll" tabindex="0" role="region" aria-labelledby="cv-op">
        <table class="jtable cv-table">
          <caption><b>{t.ui.table} 1.</b> {a.opCaption}</caption>
          <thead><tr><th scope="col">{a.opHead[0]}</th><th scope="col">{a.opHead[1]}</th><th scope="col">{a.opHead[2]}</th></tr></thead>
          <tbody>
            {a.operating.map((r) => <tr><td>{r.p}</td><td>{r.v}</td><td class="note">{r.c}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <div class="cv-cols">
      <section class="cv-sec" aria-labelledby="cv-pub">
        <h2 class="cv-h" id="cv-pub">{s.publications}</h2>
        <ol class="cv-refs">
          {a.publications.map((p) => (
            <li><span>{p.text}</span> <span class:list={['cv-status', { 'cv-status--pending': p.pending }]}>{p.status}</span></li>
          ))}
        </ol>
      </section>
      <section class="cv-sec" aria-labelledby="cv-hist">
        <h2 class="cv-h" id="cv-hist">{s.history}</h2>
        <ol class="cv-chron">
          {a.history.map((r) => <li><span class="cv-date">{r.d}</span><span>{r.t}</span></li>)}
        </ol>
      </section>
    </div>
  </article>

  <Contact t={t} onePager={false} />
</Page>

<script>
  import '../scripts/ticker.ts';
</script>

<style>
  .cv { display: grid; gap: clamp(64px, 8vw, 112px); padding-block: clamp(32px, 4vw, 56px) var(--section); }
  .cv-back { color: var(--muted); justify-self: start; margin-bottom: calc(clamp(64px, 8vw, 112px) * -0.6); }
  .cv-back:hover { color: var(--fg); }
  .cv-head { display: grid; gap: 40px; align-items: end; padding-bottom: clamp(32px, 4vw, 48px); border-bottom: 1.5px solid var(--c-tinta); }
  .cv-sub { margin-top: 22px; font-style: italic; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.35; color: var(--muted); max-width: 32ch; }
  .cv-fig { width: min(100%, 300px); }
  .cv-fig :global(.cv-plate) { aspect-ratio: 4 / 5; width: 100%; height: auto; }
  .cv-cols { display: grid; gap: clamp(56px, 7vw, 96px); }
  .cv-sec { display: grid; gap: 24px; align-content: start; min-width: 0; }
  .cv-h { font-weight: 400; font-size: var(--t-head); line-height: 1.1; letter-spacing: -0.015em; }
  .cv-prose { display: grid; gap: 1em; max-width: 62ch; }
  .cv-list { margin: 0; padding: 0 0 0 1.1em; display: grid; gap: 12px; }
  .cv-list li::marker { color: var(--accent); }
  .cv-table { min-width: 620px; }
  .cv-refs { margin: 0; padding-left: 1.6em; display: grid; gap: 14px; }
  .cv-refs li::marker { font: 500 14px var(--font-sans); color: var(--muted); }
  .cv-status { font: 500 13px var(--font-sans); color: var(--muted); margin-left: 6px; white-space: nowrap; }
  .cv-status--pending { font-style: italic; font-family: var(--font-serif); font-weight: 400; font-size: 16px; }
  .cv-chron { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--c-tinta); }
  .cv-chron li { display: grid; grid-template-columns: 8.5em minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); font-size: 17px; }
  .cv-date { font: 500 14px/1.9 var(--font-sans); color: var(--accent); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
  @media (max-width: 479px) { .cv-chron li { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
  @media (min-width: 820px) { .cv-head { grid-template-columns: minmax(0, 1fr) auto; } }
  @media (min-width: 1000px) { .cv-cols { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
</style>
