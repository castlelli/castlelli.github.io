---
// The One Pager: a CV that reads on screen and prints on one sheet.
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import Poli from '../components/axes/Poli.astro';
import Icb from '../components/axes/Icb.astro';
import Embedded from '../components/axes/Embedded.astro';
import Edge from '../components/axes/Edge.astro';
import Health from '../components/axes/Health.astro';
import { findPhoto } from '../lib/photo';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const a = t.about;
const s = a.sections;
const portrait = findPhoto('portrait');
const drawings = { poli: Poli, icb: Icb, embedded: Embedded, edge: Edge, health: Health } as const;
---
<Page t={t} page="about">
  <header class="band cv-hd">
    <div class="wrap cv-hd-in">
      <div class="cv-id">
        <a class="link cv-back" href={t.paths.home}><Arrow dir="left" /> {a.back}</a>
        <h1 class="display">{a.title}</h1>
        <p class="lead cv-sub">{a.subtitle}</p>
      </div>
      {portrait && (
        <figure class="cv-portrait">
          <img src={portrait} alt={a.portraitAlt} width="900" height="862" fetchpriority="high" decoding="async" />
        </figure>
      )}
    </div>
  </header>

  <div class="wrap cv">
    <section class="cv-sec cv-summary" aria-labelledby="cv-sum">
      <h2 class="cv-h" id="cv-sum">{s.summary}</h2>
      <div class="cv-prose">{a.summary.map((p) => <p>{p}</p>)}</div>
    </section>

    <section class="cv-sec" aria-labelledby="cv-res">
      <h2 class="cv-h" id="cv-res">{s.research}</h2>
      <ul class="cv-rows">{a.research.map((r) => <li><span>{r.t}</span><span class="cv-when">{r.s}</span></li>)}</ul>
    </section>

    <section class="cv-sec" aria-labelledby="cv-exp">
      <h2 class="cv-h" id="cv-exp">{s.experience}</h2>
      <ol class="cv-chron">{a.experience.map((r) => <li><span class="cv-date">{r.d}</span><span>{r.t}</span></li>)}</ol>
    </section>

    <section class="cv-sec" aria-labelledby="cv-edu">
      <h2 class="cv-h" id="cv-edu">{s.education}</h2>
      <ol class="cv-chron">{a.education.map((r) => <li><span class="cv-date">{r.d}</span><span>{r.t}</span></li>)}</ol>
    </section>

    <section class="cv-sec" aria-labelledby="cv-sk">
      <h2 class="cv-h" id="cv-sk">{s.skills}</h2>
      <dl class="cv-skills">{a.skills.map((r) => <div><dt>{r.p}</dt><dd>{r.v}</dd></div>)}</dl>
    </section>
  </div>

  <section class="cv-draw" aria-labelledby="cv-dr">
    <div class="wrap">
      <h2 class="cv-h" id="cv-dr">{s.drawings}</h2>
      <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="7" stroke="var(--draw-soft)" stroke-width="1.2" />
          </pattern>
        </defs>
      </svg>
      <ul class="axes">
        {a.axes.map((ax) => {
          const Drawing = drawings[ax.id as keyof typeof drawings];
          return (
            <li class={`ax ax--${ax.id}`}>
              <div class="ax-draw" role="img" aria-label={ax.alt}><Drawing /></div>
              <p><b>{ax.name}</b> <span>{ax.sub}</span></p>
            </li>
          );
        })}
      </ul>
      <p class="cap">{a.drawingsCaption}</p>
    </div>
  </section>
</Page>

<style>
  .cv-hd-in { display: grid; gap: 32px; align-items: end; padding-top: clamp(16px, 3vw, 32px); }
  .cv-id { display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(40px, 5vw, 72px); }
  .cv-back { color: var(--on-band-muted); text-decoration: none; }
  .cv-back:hover { color: var(--on-band); }
  .cv-hd h1 { max-width: 9ch; }
  .cv-sub { max-width: 40ch; color: var(--on-band); }
  .cv-portrait { justify-self: center; width: min(100%, 420px); position: relative; }
  .cv-portrait::after { content: ""; position: absolute; right: 12%; top: 8%; width: 9%; aspect-ratio: 1; background: var(--c-fluorescein); }
  .cv-portrait img { width: 100%; height: auto; display: block; }
  @media (min-width: 900px) { .cv-hd-in { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } .cv-portrait { justify-self: end; } }

  .cv { display: grid; gap: 0; padding-block: clamp(48px, 6vw, 88px) var(--section); }
  .cv-sec { display: grid; gap: 16px; padding-block: 36px; border-top: 1px solid var(--rule-strong); }
  .cv-sec:first-child { border-top: 0; padding-top: 0; }
  .cv-h { font-family: var(--font-display); font-weight: 650; font-size: var(--t-h3); line-height: 1.15; letter-spacing: -0.02em; }
  .cv-prose { display: grid; gap: 0.9em; max-width: 66ch; font-size: 18px; line-height: 1.6; }
  .cv-prose p:first-child { font-size: var(--t-lead); line-height: 1.45; }
  .cv-rows, .cv-chron { list-style: none; }
  .cv-rows li, .cv-chron li { display: grid; gap: 4px 24px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .cv-rows li:last-child, .cv-chron li:last-child { border-bottom: 0; }
  .cv-when, .cv-date { font-size: 14px; color: var(--muted); white-space: nowrap; }
  .cv-date { font-weight: 600; color: var(--accent); }
  .cv-skills { display: grid; }
  .cv-skills div { display: grid; gap: 2px 24px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .cv-skills div:last-child { border-bottom: 0; }
  .cv-skills dt { font-weight: 600; }
  .cv-skills dd { color: var(--muted); }
  @media (min-width: 760px) {
    .cv-sec { grid-template-columns: 14rem minmax(0, 1fr); gap: 32px; }
    .cv-rows li { grid-template-columns: minmax(0, 1fr) auto; }
    .cv-chron li { grid-template-columns: 8rem minmax(0, 1fr); }
    .cv-skills div { grid-template-columns: 12rem minmax(0, 1fr); }
  }

  .cv-draw { border-top: 1px solid var(--rule); padding-block: var(--section); }
  .cv-draw .wrap { display: grid; gap: 28px; }
  .axes { list-style: none; display: grid; gap: 40px 32px; grid-template-columns: minmax(0, 1fr); }
  .ax { display: grid; gap: 12px; align-content: start; }
  .ax-draw :global(svg) { width: 100%; height: auto; overflow: visible; }
  .ax p { font-size: 15px; }
  .ax p span { color: var(--muted); }
  /* static views of the drawings: no controls, the default state only */
  .axes :global(.ax-view--b), .axes :global(.x-ghost), .axes :global(.x-proj), .axes :global(.h-pulse), .axes :global(.e-quant) { display: none; }
  .axes :global(.h-vent) { fill: var(--draw); opacity: 0; }
  .axes :global(.h-tri) { fill: var(--bg); stroke: var(--draw); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  @media (min-width: 700px) { .axes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) {
    .axes { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .ax--poli, .ax--icb { grid-column: span 3; }
    .ax--embedded, .ax--edge, .ax--health { grid-column: span 2; }
  }

  @media print {
    :global(.hd), :global(.foot), :global(.skip), .cv-back, .cv-draw { display: none !important; }
    :global(body) { background: #fff; color: #000; font-size: 11pt; }
    .band { background: #fff; color: #000; }
    .cv-hd-in { grid-template-columns: 1fr 140px; padding: 0; }
    .cv-sub { color: #000; }
    .cv-portrait { width: 140px; }
    .cv-portrait::after { display: none; }
    .cv { padding: 0; }
    .cv-sec { padding-block: 10pt; break-inside: avoid; }
  }
</style>
