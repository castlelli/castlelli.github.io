---
import '../styles/global.css';
import '../styles/sheet.css';
import Monogram from '../components/Monogram.astro';
import type { Dict } from '../i18n/en';

// A work page passes its own path and its translation's path in `paths`.
interface Props { t: Dict; page: 'home' | 'about' | 'work'; paths?: { self: string; other: string } }
const { t, page, paths } = Astro.props;
const title = page === 'about' ? t.meta.aboutTitle : t.meta.title;
const description = page === 'about' ? t.meta.aboutDescription : t.meta.description;
const self = paths?.self ?? (page === 'about' ? t.paths.about : t.paths.home);
const other = paths?.other ?? (page === 'about' ? t.paths.otherAbout : t.paths.other);
const site = Astro.site!;
const href = (id: string) => (page === 'home' ? `#${id}` : `${t.paths.home}#${id}`);
const modes = ['blueprint', 'paper', 'graphite'] as const;
const layers = ['grid', 'dims', 'notes'] as const;
const zonesX = ['1', '2', '3', '4', '5', '6', '7', '8'];
const zonesY = ['A', 'B', 'C', 'D', 'E', 'F'];
---
<!doctype html>
<html lang={t.htmlLang} data-mode="blueprint">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(self, site)} />
    <link rel="alternate" hreflang={t.lang === 'en' ? 'en' : 'pt-BR'} href={new URL(self, site)} />
    <link rel="alternate" hreflang={t.lang === 'en' ? 'pt-BR' : 'en'} href={new URL(other, site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(self, site)} />
    <meta name="theme-color" content="#24338F" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var m = localStorage.getItem('vc-mode');
          if (m === 'paper' || m === 'graphite' || m === 'blueprint') d.setAttribute('data-mode', m);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.ui.skip}</a>

    <header class="tb">
      <a class="tb-logo" href={t.paths.home} aria-label="Vinicius Castelli"><Monogram /></a>
      <span class="tb-cell tb-name legend">V. Castelli</span>
      <nav class="tb-nav" aria-label={t.ui.menu}>
        {t.nav.map((n) => (
          <a class="tb-link" href={href(n.id)} data-nav={n.id}><span>{n.n}</span>{n.label}</a>
        ))}
        <a class="tb-link" href={t.paths.about} aria-current={page === 'about' ? 'page' : undefined}><span>OP</span>{t.ui.datasheet}</a>
      </nav>
      <div class="tb-tools">
        <div class="tb-readout mono" aria-hidden="true"><span data-xy>X 0000 · Y 0000</span><span data-pct>000 %</span></div>
        <div class="tb-seg" role="group" aria-label={t.ui.mode}>
          {modes.map((m) => (
            <button type="button" data-set-mode={m} aria-pressed="false" title={t.ui.modes[m]}>
              <span class="sw" data-sw={m} aria-hidden="true"></span><span class="vh">{t.ui.modes[m]}</span>
            </button>
          ))}
        </div>
        <details class="tb-layers">
          <summary class="legend">{t.ui.layers}</summary>
          <div class="tb-pop">
            {layers.map((l) => (
              <label><input type="checkbox" checked data-toggle-layer={l} /> {t.ui.layerNames[l]}</label>
            ))}
          </div>
        </details>
        <a class="tb-lang legend" href={other} hreflang={t.lang === 'en' ? 'pt-BR' : 'en'} lang={t.lang === 'en' ? 'pt-BR' : 'en'} aria-label={t.otherName}>{t.otherLabel}</a>
      </div>
      <button type="button" class="tb-menu legend" data-open-menu aria-haspopup="dialog">
        <span data-current-sheet>{t.ui.menu}</span><span aria-hidden="true">≡</span>
      </button>
    </header>

    <dialog class="menu" data-menu aria-label={t.ui.menu}>
      <div class="menu-head">
        <span class="legend">{t.ui.menu}</span>
        <button type="button" class="btn btn--sm" data-close-menu>{t.ui.close}</button>
      </div>
      <nav class="menu-nav">
        {t.nav.map((n) => (
          <a href={href(n.id)} data-close-menu><span class="mono">{n.n}</span>{n.label}</a>
        ))}
        <a href={t.paths.about} data-close-menu><span class="mono">OP</span>{t.ui.datasheet}</a>
      </nav>
      <div class="menu-tools">
        <p class="legend">{t.ui.mode}</p>
        <div class="menu-row">
          {modes.map((m) => (
            <button type="button" class="btn btn--sm" data-set-mode={m} aria-pressed="false">{t.ui.modes[m]}</button>
          ))}
        </div>
        <p class="legend">{t.ui.layers}</p>
        <div class="menu-row">
          {layers.map((l) => (
            <label class="menu-check"><input type="checkbox" checked data-toggle-layer={l} /> {t.ui.layerNames[l]}</label>
          ))}
        </div>
        <a class="btn btn--sm" href={other} lang={t.lang === 'en' ? 'pt-BR' : 'en'}>{t.otherName}</a>
      </div>
    </dialog>

    <!-- drawing frame and instruments: decoration only -->
    <div class="frame" aria-hidden="true">
      <div class="zones-x">{zonesX.map((z) => <span>{z}</span>)}</div>
      <div class="zones-y">{zonesY.map((z) => <span>{z}</span>)}</div>
      <div class="trace"><i data-trace-dot></i></div>
    </div>
    <div class="xh xh-h" data-xh-h aria-hidden="true"></div>
    <div class="xh xh-v" data-xh-v aria-hidden="true"></div>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="var(--draw-soft)" stroke-width="1.2" />
        </pattern>
      </defs>
    </svg>

    <main id="main"><slot /></main>

    <footer class="foot wrap">
      <dl class="tblock">
        <div><dt>{t.ui.drawn}</dt><dd>{t.footer.block.drawn}</dd></div>
        <div><dt>{t.ui.date}</dt><dd>{t.footer.block.date}</dd></div>
        <div><dt>{t.ui.sheet}</dt><dd>{t.footer.block.sheet}</dd></div>
        <div><dt>Rev.</dt><dd>A</dd></div>
      </dl>
    </footer>

    <script>
      import '../scripts/sheet.ts';
    </script>
  </body>
</html>
