---
// "How I see it": three convictions, one line. Chapters scroll natively; on wide
// screens a sticky ultramarine panel reshapes a single fluorescein line as each
// chapter reaches the reading line. Without JS, every chapter carries its own figure.
import { shapes, toPath } from '../lib/lines';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const s = t.story;
const ys = shapes();
const W = 600, H = 400;
const total = s.chapters.length;
const endOf = (y: number[]) => ({ x: W - 24, y: H / 2 - y[y.length - 1] * H * 0.38 });
const e0 = endOf(ys[0]);
---
<section class="story" id="story" aria-labelledby="story-h" data-story data-shapes={JSON.stringify(ys)}>
  <div class="wrap story-in">
    <div class="story-text">
      <h2 class="h2 story-h" id="story-h">{s.title}</h2>
      {s.chapters.map((c, i) => (
        <article class="ch" data-chapter={i} aria-labelledby={`ch-${c.key}`}>
          <p class="ch-label"><i aria-hidden="true"></i>{c.label}</p>
          <h3 class="ch-h" id={`ch-${c.key}`}><span>{c.h}</span><span class="ch-stain" aria-hidden="true">{c.h}</span></h3>
          <p class="ch-p">{c.p}</p>
          <figure class="ch-fig">
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={c.cap}>
              <path class="ch-line" d={toPath(ys[i], W, H)} pathLength="1" />
            </svg>
            <figcaption>{c.cap}</figcaption>
          </figure>
        </article>
      ))}
    </div>

    <div class="panel" aria-hidden="true">
      <div class="panel-in">
        <div class="panel-top"><span data-panel-label>{s.chapters[0].label}</span><span><b data-panel-n>1</b> {s.of} {total}</span></div>
        <svg viewBox={`0 0 ${W} ${H}`} class="panel-svg">
          <g class="panel-grid">
            {[1, 2, 3].map((k) => <line x1="24" x2={W - 24} y1={(H / 4) * k} y2={(H / 4) * k} />)}
            {[1, 2, 3, 4, 5].map((k) => <line y1="24" y2={H - 24} x1={24 + ((W - 48) / 6) * k} x2={24 + ((W - 48) / 6) * k} />)}
          </g>
          <path class="panel-line" data-line d={toPath(ys[0], W, H)} />
          <rect class="panel-dot" data-dot x={e0.x - 6} y={e0.y - 6} width="12" height="12" />
        </svg>
        <p class="panel-cap" data-panel-cap>{s.chapters[0].cap}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/story.ts';
</script>

<style>
  .story { padding-block: clamp(56px, 7vw, 104px) clamp(24px, 3vw, 48px); border-bottom: 1px solid var(--rule); }
  .story-in { display: grid; gap: 32px; }
  .story-h { margin-bottom: 8px; }
  .ch { display: grid; gap: 14px; align-content: center; padding-block: 36px; border-top: 1px solid var(--rule); }
  .ch-label { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--muted); transition: color 320ms var(--ease); }
  .ch-label i { width: 9px; height: 9px; box-shadow: inset 0 0 0 1.5px currentColor; transition: background-color 320ms var(--ease); }
  .ch.is-active .ch-label { color: var(--accent); }
  .ch.is-active .ch-label i { background: var(--accent); box-shadow: none; }
  .ch-h { position: relative; font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 4vw, 56px); line-height: 1.02; letter-spacing: -0.035em; text-wrap: balance; max-width: 16ch; }
  .ch-stain { position: absolute; inset: 0; color: var(--accent); clip-path: inset(0 100% 0 0); pointer-events: none; }
  .ch-p { font-size: var(--t-lead); line-height: 1.5; max-width: 40ch; color: var(--fg); }

  /* inline figure: phones, and every screen without JS */
  .ch-fig { margin-top: 10px; background: var(--band); padding: 12px; }
  .ch-fig svg { width: 100%; height: auto; }
  .ch-line { fill: none; stroke: var(--signal); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .ch-fig figcaption { color: var(--on-band-muted); font-size: 13px; padding: 4px 4px 2px; }

  .panel { display: none; }

  @media (min-width: 1000px) {
    .story-in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(48px, 6vw, 96px); align-items: start; }
    .ch { min-height: 62vh; }
    :global(.js) .ch-fig { display: none; }
    :global(.js) .panel { display: block; position: sticky; top: 12vh; height: 76vh; }
    .panel-in { height: 100%; display: grid; grid-template-rows: auto 1fr auto; gap: 12px; background: var(--band); color: var(--on-band); padding: 24px 28px; }
    .panel-top { display: flex; justify-content: space-between; font-size: 14px; font-weight: 600; color: var(--on-band-muted); }
    .panel-top b { color: var(--on-band); font-weight: 700; }
    .panel-svg { width: 100%; height: 100%; min-height: 0; }
    .panel-grid line { stroke: rgba(255, 255, 255, 0.12); stroke-width: 1; vector-effect: non-scaling-stroke; }
    .panel-line { fill: none; stroke: var(--signal); stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
    .panel-dot { fill: var(--signal); }
    .panel-cap { font-size: 15px; color: var(--on-band); min-height: 1.5em; }
  }
</style>
