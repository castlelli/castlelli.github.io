---
// A photo the author supplies in public/photos/<name>.jpg. Until the file
// exists the slot shows the monogram on a plate (fallback "mark") or nothing.
import { existsSync } from 'node:fs';
import Monogram from './Monogram.astro';
interface Props { name: string; alt: string; fallback?: 'mark' | 'none'; class?: string }
const { name, alt, fallback = 'none', class: cls } = Astro.props;
const src = `/photos/${name}.jpg`;
const has = existsSync(`public${src}`);
---
{has && <img class:list={['photo', cls]} src={src} alt={alt} loading="lazy" decoding="async" />}
{!has && fallback === 'mark' && <div class:list={['plate', 'photo-mark', cls]} data-ground="plate"><Monogram /></div>}

<style>
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.92) contrast(1.02); }
  .photo-mark { display: grid; place-items: center; aspect-ratio: 4 / 5; }
  .photo-mark :global(.mono-vc) { width: 54%; height: auto; }
</style>
