---
// The tools inside a collection, each with its own live page.
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict; items: CollectionEntry<'work'>['data']['items'] }
const { t, items } = Astro.props;
const isRepo = (href: string) => href.includes('github.com');
---
<ol class="tl">
  {items.map((it) => (
    <li class:list={['tl-item', { 'tl-item--text': !it.image }]}>
      {it.image && (
        <a class="tl-fig" href={it.href} tabindex="-1" aria-hidden="true">
          <img src={`${it.image}-800.webp`} srcset={`${it.image}-800.webp 800w, ${it.image}-1600.webp 1600w`} sizes="(min-width: 900px) 44vw, 100vw" alt={it.imageAlt ?? ''} width="800" height="500" loading="lazy" decoding="async" />
        </a>
      )}
      <div class="tl-body">
        <h3 class="h3">{it.title}</h3>
        <p>{it.summary}</p>
        <a class="link" href={it.href}>{isRepo(it.href) ? t.ui.source : t.ui.open} <Arrow dir="out" /></a>
      </div>
    </li>
  ))}
</ol>

<style>
  .tl { list-style: none; display: grid; border-top: 1px solid var(--rule-strong); }
  .tl-item { display: grid; gap: 20px; padding-block: 32px; border-bottom: 1px solid var(--rule); }
  .tl-fig { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); outline: 1px solid var(--rule); outline-offset: -1px; }
  .tl-fig img { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform 520ms var(--ease); }
  .tl-fig:hover img { transform: scale(1.02); }
  .tl-body { display: grid; gap: 10px; align-content: start; justify-items: start; }
  .tl-body p { color: var(--muted); max-width: 52ch; }
  .tl-body .link { color: var(--accent); }
  @media (min-width: 900px) {
    .tl-item { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
    .tl-item--text .tl-body { grid-column: 2; }
  }
</style>
