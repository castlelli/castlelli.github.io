---
// Fig.: fibroblast states in SSc skin (GSE138669) as a PAGA graph, from the
// vildagliptin project's own figure data (src/data/vildagliptin, copied from
// castlelli/vildagliptin-for-sclerosis with its source notes). Colour is a
// diverging scale on the SSc effect; significant states carry an outline as
// a second cue. Inset: DPP4-positive fraction by cell type, control vs SSc.
import paga from '../../data/vildagliptin/paga.json';
import dpp4 from '../../data/vildagliptin/dpp4-celltypes.json';
import type { Dict } from '../../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const L = t.work.figs.paga;
const lang = t.lang as 'en' | 'pt';
const f1 = (n: number) => (lang === 'pt' ? n.toFixed(2).replace('.', ',') : n.toFixed(2));
const sign = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + f1(Math.abs(n));

// graph area
const G = { l: 70, r: 590, t: 70, b: 520 };
const xs = paga.nodes.map((n) => n.x), ys = paga.nodes.map((n) => n.y);
const [x0, x1, y0, y1] = [Math.min(...xs) - 0.5, Math.max(...xs) + 0.5, Math.min(...ys) - 0.5, Math.max(...ys) + 0.5];
const X = (x: number) => G.l + ((x - x0) / (x1 - x0)) * (G.r - G.l);
const Y = (y: number) => G.b - ((y - y0) / (y1 - y0)) * (G.b - G.t);
const node = (id: number) => paga.nodes.find((n) => n.id === id)!;
const R = (s: number) => 12 + s * 7;

// diverging colour: cool (lower in SSc) – gray – copper (higher in SSc), validated on the plate
const LOW = [0x6f, 0x86, 0xf6], MID = [0x8a, 0x8f, 0xa8], HIGH = [0xcf, 0x78, 0x36];
const lim = 0.2;
const col = (v: number) => {
  const k = Math.max(-1, Math.min(1, v / lim)), [a, b] = k < 0 ? [MID, LOW] : [MID, HIGH], u = Math.abs(k);
  return '#' + a.map((c, i) => Math.round(c + (b[i] - c) * u).toString(16).padStart(2, '0')).join('');
};
const branch = paga.branches.find((b) => b.id === 'dpp4')!.path;
const myo = paga.branches.find((b) => b.id === 'myo')!.path;
const pathD = (ids: number[]) => ids.map((id, i) => `${i ? 'L' : 'M'}${X(node(id).x).toFixed(1)} ${Y(node(id).y).toFixed(1)}`).join('');
const stateName = (s: string) => (L.states as Record<string, string>)[s] ?? s;
// a label flips above its node when another node sits just below it
const labelAbove = (n: (typeof paga.nodes)[number]) => paga.nodes.some((m) => m.id !== n.id && Math.abs(X(m.x) - X(n.x)) < 70 && Y(m.y) - Y(n.y) > 0 && Y(m.y) - Y(n.y) < R(n.size) + R(m.size) + 30);

// inset: DPP4-positive cells by cell type
const I = { l: 760, r: 975, t: 112, row: 44 };
const vmax = 16;
const BX = (v: number) => I.l + (v / vmax) * (I.r - I.l);
const cells = dpp4.data;
---
<figure class="paga" data-paga>
  <svg viewBox="0 0 1000 640" role="img" aria-label={L.alt}>
    <!-- edges, weak then strong -->
    <g class="pg-edges">
      {[...paga.edges].sort((a, b) => a[2] - b[2]).map(([a, b, w]) => (
        <path class:list={['pg-e', { 'pg-e--strong': w >= 3 }]} d={pathD([a, b])} pathLength="1" />
      ))}
    </g>
    <path class="pg-myo" d={pathD(myo)} />
    <path class="pg-branch" d={pathD(branch)} pathLength="1" />
    <!-- nodes -->
    {paga.nodes.map((n) => (
      <g class="pg-n" tabindex="0" data-tip={`${n.id} · ${stateName(n.state)} — SSc ${sign(n.ssc)}${n.sig ? ' *' : ''}`} transform={`translate(${X(n.x).toFixed(1)} ${Y(n.y).toFixed(1)})`}>
        <circle class="pg-hit" r={R(n.size) + 8} />
        <circle class:list={['pg-dot', { 'pg-sig': n.sig }]} r={R(n.size)} fill={col(n.ssc)} />
        <text class="pg-id" y="5" text-anchor="middle">{n.id}</text>
        <text class="pg-state" y={labelAbove(n) ? -R(n.size) - 10 : R(n.size) + 18} text-anchor="middle">{stateName(n.state)}</text>
      </g>
    ))}
    <text class="pg-branch-l" x={X(node(4).x) - 6} y={Y(node(4).y) - R(node(4).size) - 18} text-anchor="middle">{L.legend.branch}</text>

    <!-- colour key -->
    <defs>
      <linearGradient id="pg-key"><stop offset="0" stop-color="#6F86F6" /><stop offset="0.5" stop-color="#8A8FA8" /><stop offset="1" stop-color="#CF7836" /></linearGradient>
    </defs>
    <g class="pg-key" transform="translate(70 590)">
      <rect width="220" height="8" rx="4" fill="url(#pg-key)" />
      <text x="0" y="30">{L.legend.low}</text>
      <text x="110" y="30" text-anchor="middle">0</text>
      <text x="220" y="30" text-anchor="end">{L.legend.high}</text>
      <circle cx="300" cy="4" r="8" class="pg-dot pg-sig" fill="#8A8FA8" /><text x="316" y="9">{L.legend.sig}</text>
    </g>

    <!-- inset -->
    <g class="pg-inset">
      <text class="pg-inset-t" x="650" y="72">{L.legend.inset}</text>
      <g transform="translate(0 0)">
        <rect x="650" y="86" width="10" height="10" rx="2" fill="#6F86F6" /><text class="pg-k" x="666" y="95">{L.legend.control}</text>
        <rect x="760" y="86" width="10" height="10" rx="2" fill="#CF7836" /><text class="pg-k" x="776" y="95">{L.legend.ssc}</text>
      </g>
      <path class="pg-base" d={`M${I.l} ${I.t}V${I.t + cells.length * I.row - 8}`} />
      {cells.map((c, i) => {
        const y = I.t + i * I.row;
        return (
          <g class="pg-row" tabindex="0" data-tip={`${c.cell}: ${L.legend.control} ${String(c.control).replace('.', lang === 'pt' ? ',' : '.')} %, ${L.legend.ssc} ${String(c.ssc).replace('.', lang === 'pt' ? ',' : '.')} %`}>
            <rect class="pg-hit" x="640" y={y - 4} width="345" height={I.row - 6} />
            <text class="pg-cell" x={I.l - 12} y={y + 17} text-anchor="end">{c.cell}</text>
            <rect class="pg-bar" x={I.l} y={y + 2} width={Math.max(3, BX(c.control) - I.l)} height="11" rx="4" fill="#6F86F6" style={`--d:${i}`} />
            <rect class="pg-bar" x={I.l} y={y + 15} width={Math.max(3, BX(c.ssc) - I.l)} height="11" rx="4" fill="#CF7836" style={`--d:${i}`} />
            {i === 0 && <text class="pg-v" x={BX(c.ssc) + 8} y={y + 25}>{String(c.ssc).replace('.', lang === 'pt' ? ',' : '.')}</text>}
            {i === 0 && <text class="pg-v" x={BX(c.control) + 8} y={y + 12}>{String(c.control).replace('.', lang === 'pt' ? ',' : '.')}</text>}
          </g>
        );
      })}
      {[0, 5, 10, 15].map((v) => <text class="pg-tick" x={BX(v)} y={I.t + cells.length * I.row + 10} text-anchor="middle">{v}</text>)}
    </g>
  </svg>
  <p class="pg-tip" data-tip-box hidden></p>
  <table class="vh">
    <caption>{L.legend.inset}</caption>
    <thead><tr><th scope="col">Cell</th><th scope="col">{L.legend.control}</th><th scope="col">{L.legend.ssc}</th></tr></thead>
    <tbody>{cells.map((c) => <tr><th scope="row">{c.cell}</th><td>{c.control}</td><td>{c.ssc}</td></tr>)}</tbody>
  </table>
</figure>

<script>
  // hover and focus tooltips; the branch draws itself when the figure scrolls in
  document.querySelectorAll<HTMLElement>('[data-paga]').forEach((fig) => {
    const box = fig.querySelector<HTMLElement>('[data-tip-box]')!;
    const show = (el: Element, e?: PointerEvent) => {
      box.textContent = (el as HTMLElement).dataset.tip || '';
      box.hidden = false;
      const fr = fig.getBoundingClientRect(), r = el.getBoundingClientRect();
      const x = (e ? e.clientX : r.left + r.width / 2) - fr.left, y = (e ? e.clientY : r.top) - fr.top;
      box.style.left = `${Math.min(fr.width - 220, Math.max(0, x + 14))}px`; box.style.top = `${Math.max(0, y - 44)}px`;
    };
    fig.querySelectorAll('[data-tip]').forEach((el) => {
      el.addEventListener('pointermove', (e) => show(el, e as PointerEvent));
      el.addEventListener('pointerleave', () => (box.hidden = true));
      el.addEventListener('focus', () => show(el));
      el.addEventListener('blur', () => (box.hidden = true));
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    fig.classList.add('pending');
    new IntersectionObserver(([en], io) => { if (en.isIntersecting) { fig.classList.remove('pending'); fig.classList.add('run'); io.disconnect(); } }, { threshold: 0.3 }).observe(fig);
  });
</script>

<style>
  .paga { position: relative; margin: 0; }
  .paga svg { width: 100%; height: auto; overflow: visible; }
  .pg-e { fill: none; stroke: rgba(243, 241, 234, 0.22); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .pg-e--strong { stroke: rgba(243, 241, 234, 0.6); stroke-width: 2.2; }
  .pg-myo { fill: none; stroke: rgba(243, 241, 234, 0.55); stroke-width: 1.4; stroke-dasharray: 5 6; vector-effect: non-scaling-stroke; }
  .pg-branch { fill: none; stroke: var(--c-papel); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .pg-dot { stroke: var(--c-coomassie); stroke-width: 3; }
  .pg-sig { stroke: var(--c-papel); stroke-width: 2.4; }
  .pg-hit { fill: transparent; }
  .pg-n, .pg-row { cursor: default; outline: none; }
  .pg-n:focus-visible .pg-dot, .pg-n:hover .pg-dot { stroke: var(--c-papel); stroke-width: 4; }
  .pg-id { fill: #10154a; font: 600 15px var(--font-sans); pointer-events: none; }
  .pg-state { fill: var(--c-coomassie-tinta); font: italic 15px var(--font-serif); pointer-events: none; }
  .pg-branch-l { fill: var(--c-papel); font: 500 14px var(--font-sans); letter-spacing: 0.02em; }
  .pg-key text { fill: var(--c-coomassie-tinta); font: 13px var(--font-sans); }
  .pg-inset-t { fill: var(--c-papel); font: 500 15px var(--font-sans); }
  .pg-k, .pg-cell, .pg-tick { fill: var(--c-coomassie-tinta); font: 13px var(--font-sans); }
  .pg-cell { fill: var(--c-papel); }
  .pg-v { fill: var(--c-papel); font: 500 13px var(--font-sans); font-variant-numeric: tabular-nums; }
  .pg-base { stroke: rgba(243, 241, 234, 0.4); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .pg-row:hover .pg-cell, .pg-row:focus-visible .pg-cell { text-decoration: underline; }
  .pg-tip {
    position: absolute; z-index: 5; pointer-events: none; max-width: 240px; padding: 8px 11px;
    background: var(--c-papel); color: var(--c-tinta); font: 500 13px/1.35 var(--font-sans); box-shadow: 0 10px 30px -10px rgba(5, 8, 30, 0.6);
  }

  /* entrance: edges, then nodes, then the branch, then the bars */
  :global(.js) .paga.pending .pg-e, :global(.js) .paga.pending .pg-branch { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.js) .paga.pending .pg-n, :global(.js) .paga.pending .pg-branch-l, :global(.js) .paga.pending .pg-myo { opacity: 0; }
  :global(.js) .paga.pending .pg-bar { transform: scaleX(0); }
  .pg-bar { transform-box: fill-box; transform-origin: left center; }
  .paga.run .pg-e { stroke-dasharray: 1; animation: pg-draw 0.9s cubic-bezier(0.65, 0, 0.35, 1) both; }
  .paga.run .pg-n { animation: pg-pop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both 0.5s; }
  .paga.run .pg-myo { animation: pg-fade 0.6s ease both 1s; }
  .paga.run .pg-branch { stroke-dasharray: 1; animation: pg-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) both 1.1s; }
  .paga.run .pg-branch-l { animation: pg-fade 0.5s ease both 2s; }
  .paga.run .pg-bar { animation: pg-grow 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(0.9s + var(--d) * 70ms); }
  @keyframes pg-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pg-pop { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pg-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pg-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (max-width: 600px) {
    .pg-state, .pg-key text, .pg-k, .pg-cell, .pg-tick, .pg-v { font-size: 22px; }
    .pg-id { font-size: 20px; }
    .pg-inset-t, .pg-branch-l { font-size: 22px; }
  }
</style>
