---
// The vildagliptin hypothesis as a cell diagram: a DPP-4-positive progenitor
// fibroblast becomes a collagen-laying myofibroblast; vildagliptin blocks DPP-4,
// and whether that slows fibrosis is the open question, drawn as a "?".
interface Props {
  alt: string;
  labels: { progenitor: string; dpp4: string; myo: string; collagen: string; drug: string };
}
const { alt, labels } = Astro.props;
const f = (n: number) => n.toFixed(1);

// progenitor: a bipolar spindle. Half-height h(x) tapers to long thin
// processes at both ends; DPP-4 sits on the membrane of the cell body.
type P = [number, number];
const CX = 196, CY = 330, HALF = 150, HH = 34;
const hh = (x: number) => HH * Math.max(0, 1 - ((x - CX) / HALF) ** 2) ** 1.7 + 1.2;
const xs = Array.from({ length: 61 }, (_, i) => CX - HALF + i * 5);
const spindle =
  xs.map((x, i) => `${i ? 'L' : 'M'}${f(x)} ${f(CY - hh(x))}`).join('') +
  xs.slice().reverse().map((x) => `L${f(x)} ${f(CY + hh(x))}`).join('') + 'Z';
const receptors = [124, 150, 176, 202, 228, 254].flatMap((x) => [-1, 1].map((side) => {
  const y = CY + side * hh(x);
  const slope = hh(x + 0.5) - hh(x - 0.5); // h'(x)
  const len = Math.hypot(1, slope);
  const nx = -slope / len, ny = side / len; // outward normal
  const sx = x + nx * 15, sy = y + ny * 15;
  const px = -ny * 5.5, py = nx * 5.5;
  return { side, x, d: `M${f(x)} ${f(y)}L${f(sx)} ${f(sy)}M${f(sx + px)} ${f(sy + py)}Q${f(sx + nx * 8)} ${f(sy + ny * 8)} ${f(sx - px)} ${f(sy - py)}`, tip: [sx + nx * 5, sy + ny * 5] as P };
}));
const target = receptors.find((r) => r.side === -1 && r.x === 202)!;

// myofibroblast: a stellate outline from a polar function with five processes
const MX = 664, MY = 330;
const arms = [[0.1, 54, 0.03], [1.25, 30, 0.08], [2.25, 42, 0.05], [3.3, 34, 0.03], [4.4, 34, 0.07], [5.35, 26, 0.09]];
const star = Array.from({ length: 241 }, (_, i) => {
  const th = (i / 240) * Math.PI * 2;
  let r = 72 + 7 * Math.sin(th * 4 + 0.7) + 4 * Math.sin(th * 7 + 1.9);
  for (const [a, amp, wd] of arms) {
    const d = Math.atan2(Math.sin(th - a), Math.cos(th - a));
    r += amp * Math.exp(-(d * d) / wd);
  }
  const x = MX + r * Math.cos(th) * 1.25, y = MY + r * Math.sin(th) * 0.78;
  return `${i ? 'L' : 'M'}${f(x)} ${f(y)}`;
}).join('') + 'Z';
// stress fibres run along the long axis of the cell
const fibres = Array.from({ length: 11 }, (_, i) => {
  const o = -75 + i * 15;
  return `M${MX - 190} ${MY + o + 18}L${MX + 190} ${MY + o - 18}`;
}).join('');

// collagen: a bundle of wavy fibres leaving the cell
const collagen = Array.from({ length: 6 }, (_, k) => {
  const y0 = 296 + k * 11, amp = 5 + (k % 2) * 2, ph = k * 0.9;
  return Array.from({ length: 61 }, (_, i) => {
    const x = 770 + i * 3.5;
    const spread = (i / 60) ** 1.6 * (k - 2.5) * 16;
    const y = y0 + spread + amp * Math.sin(i * 0.42 + ph);
    return `${i ? 'L' : 'M'}${f(x)} ${f(y)}`;
  }).join('');
});
---
<svg class="fig-fib" viewBox="0 118 1000 372" role="img" aria-label={alt}>
  <defs>
    <clipPath id="fib-myo"><path d={star} /></clipPath>
    <marker id="fib-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" orient="auto">
      <path d="M0 1L10 5L0 9Z" fill="#F3F1EA" />
    </marker>
  </defs>

  <!-- progenitor fibroblast with DPP-4 on its membrane -->
  <path class="fb-cell" d={spindle} />
  <ellipse class="fb-nuc" cx="196" cy="330" rx="38" ry="14" />
  <ellipse class="fb-soft" cx="188" cy="328" rx="7" ry="4.5" />
  {receptors.map((r) => <path class="fb-rec" d={r.d} />)}

  <!-- vildagliptin blocks DPP-4 -->
  <text class="fb-drug" x="202" y="150" text-anchor="middle">{labels.drug}</text>
  <path class="fb-inh" d={`M202 168V${f(target.tip[1] - 14)}`} />
  <path class="fb-inh fb-bar" d={`M186 ${f(target.tip[1] - 12)}H218`} />
  <text class="fb-tag" x="230" y={f(target.tip[1] - 30)}>{labels.dpp4}</text>

  <!-- differentiation, the open question -->
  <path class="fb-arrow" d="M376 328C414 310 452 310 490 324" marker-end="url(#fib-arr)" />
  <text class="fb-q" x="433" y="296" text-anchor="middle">?</text>

  <!-- collagen, laid down by the myofibroblast -->
  {collagen.map((d) => <path class="fb-col" d={d} />)}

  <!-- myofibroblast with stress fibres -->
  <path class="fb-cell fb-myo" d={star} />
  <g clip-path="url(#fib-myo)"><path class="fb-fibre" d={fibres} /></g>
  <ellipse class="fb-nuc fb-fill" cx={MX - 6} cy={MY + 4} rx="40" ry="26" transform={`rotate(-12 ${MX - 6} ${MY + 4})`} />

  <!-- labels -->
  <text class="fb-lab fb-lab-prog" x="196" y="412" text-anchor="middle">{labels.progenitor}</text>
  <text class="fb-lab fb-lab-myo" x={MX - 10} y="454" text-anchor="middle">{labels.myo}</text>
  <text class="fb-lab fb-lab-col" x="912" y="420" text-anchor="middle">{labels.collagen}</text>
</svg>

<style>
  .fig-fib { width: 100%; height: auto; overflow: visible; }
  .fig-fib path, .fig-fib ellipse { vector-effect: non-scaling-stroke; }
  .fb-cell { fill: #2B3B98; stroke: var(--c-papel); stroke-width: 1.6; stroke-linejoin: round; }
  .fb-nuc { fill: none; stroke: var(--c-papel); stroke-width: 1.2; }
  .fb-fill { fill: var(--c-coomassie); }
  .fb-soft { fill: rgba(243, 241, 234, 0.35); stroke: none; }
  .fb-rec { fill: none; stroke: var(--c-papel); stroke-width: 1.3; stroke-linecap: round; }
  .fb-fibre { fill: none; stroke: rgba(243, 241, 234, 0.28); stroke-width: 1; }
  .fb-col { fill: none; stroke: var(--c-papel); stroke-width: 1.1; stroke-linecap: round; opacity: 0.85; }
  .fb-arrow { fill: none; stroke: var(--c-papel); stroke-width: 1.4; }
  .fb-inh { fill: none; stroke: var(--c-papel); stroke-width: 1.6; stroke-linecap: round; }
  .fb-bar { stroke-width: 3; }
  .fb-q { fill: var(--c-papel); font-family: var(--font-serif); font-style: italic; font-size: 40px; }
  .fb-drug { fill: var(--c-papel); font-family: var(--font-serif); font-style: italic; font-size: 30px; }
  .fb-lab { fill: var(--c-coomassie-tinta); font-family: var(--font-serif); font-style: italic; font-size: 26px; }
  .fb-tag { fill: var(--c-papel); font-family: var(--font-sans); font-weight: 500; font-size: 18px; letter-spacing: 0.12em; }
  @media (max-width: 600px) {
    .fb-lab { font-size: 40px; }
    .fb-drug { font-size: 46px; }
    .fb-tag { font-size: 28px; }
    .fb-q { font-size: 56px; }
    .fb-lab-prog { transform: translateY(30px); }
    .fb-lab-myo { transform: translateY(22px); }
    .fb-lab-col { transform: translateY(14px); }
  }
</style>
