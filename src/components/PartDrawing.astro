---
// A part drawing: one project drawn as a component, with its interfaces as
// pins and its numbers as dimension lines. With no entry it renders the blank
// template.
interface Dim { label: string; value: string; unit: string }
interface Props {
  sheet: string;
  labels: { part: string; role: string; dates: string; reserved: string; inPrep: string; open: string };
  alt: string;
  entry?: { title: string; summary: string; role: string; dates: string; status: string; pending: boolean; icon?: 'package' | 'oscillation'; pins: string[]; dims: Dim[]; href?: string };
  large?: boolean;
}
const { sheet, labels, alt, entry, large = false } = Astro.props;
const pins = Array.from({ length: 10 }, (_, i) => entry?.pins[i] ?? '');
const left = pins.slice(0, 5);
const right = pins.slice(5);
const dims = [0, 1, 2].map((i) => entry?.dims[i]);
const dimText = (d?: Dim) => (d ? `${d.value} ${d.unit}` : '—');
const py = (i: number) => 74 + i * 22;
const Tag = entry?.href ? 'a' : 'div';
// Dimension lines show on the blank template and only for numbers an entry has.
const showDim = (i: number) => !entry || Boolean(dims[i]);
// Oscillation chart: two periods of a sine between the axes of the window.
const wave = Array.from({ length: 81 }, (_, i) => {
  const x = 142 + i;
  const y = 120 - 24 * Math.sin((i / 80) * 4 * Math.PI);
  return `${i ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
}).join('');
---
<Tag class:list={['pd', { 'pd--empty': !entry, 'pd--large': large }]} href={entry?.href}>
  <div class="pd-top">
    <span class="legend">{sheet}</span>
    {entry && <span class:list={['tag', { 'tag--pending': entry.pending }]}>{entry.status}</span>}
  </div>
  <svg viewBox="0 0 360 236" role="img" aria-label={entry ? `${entry.title}: ${entry.summary}` : alt}>
    <!-- package -->
    <path class="dw-heavy dw-fill" d="M112 56H168A12 12 0 0 0 192 56H248V184H112Z" />
    <circle class="dw" cx="126" cy="70" r="4" />
    <rect class="dw-soft" x="132" y="84" width="96" height="72" />
    {entry?.icon === 'oscillation' ? (
      <g>
        <path class="dw" d="M140 90V150M140 120H224" />
        <path class="dw-heavy" d={wave} />
      </g>
    ) : (
      <path class="dw-soft" d="M132 84L228 156M228 84L132 156" />
    )}
    {left.map((p, i) => (
      <g>
        <path class="dw" d={`M112 ${py(i)}H92`} />
        <rect class="dw dw-fill" x="84" y={py(i) - 4} width="8" height="8" />
        <text class="dw-text lyr-note" x="78" y={py(i) + 3.5} text-anchor="end">{p || '—'}</text>
      </g>
    ))}
    {right.map((p, i) => (
      <g>
        <path class="dw" d={`M248 ${py(i)}H268`} />
        <rect class="dw dw-fill" x="268" y={py(i) - 4} width="8" height="8" />
        <text class="dw-text lyr-note" x="282" y={py(i) + 3.5}>{p || '—'}</text>
      </g>
    ))}
    <!-- dimensions -->
    {showDim(0) && <g class="dim lyr-dim">
      <path class="dw" pathLength="1" d="M112 48V22M248 48V22M106 30H254" />
      <path class="dw-heavy" pathLength="1" d="M107 35L117 25M243 35L253 25" />
      <text class="dw-text dim-v" x="180" y="24" text-anchor="middle">{dimText(dims[0])}</text>
    </g>}
    {showDim(1) && <g class="dim lyr-dim">
      <path class="dw" pathLength="1" d="M112 192V218M248 192V218M106 210H254" />
      <path class="dw-heavy" pathLength="1" d="M107 215L117 205M243 215L253 205" />
      <text class="dw-text dim-v" x="180" y="230" text-anchor="middle">{dimText(dims[1])}</text>
    </g>}
    {showDim(2) && <g class="dim lyr-dim">
      <path class="dw-centre" pathLength="1" d="M180 62V178M118 120H242" />
      <text class="dw-text dim-v" x="180" y="174" text-anchor="middle">{dimText(dims[2])}</text>
    </g>}
  </svg>
  <dl class="pd-block">
    <div class="pd-wide"><dt>{labels.part}</dt><dd class="pd-title">{entry?.title ?? '—'}</dd></div>
    <div><dt>{labels.role}</dt><dd>{entry?.role ?? '—'}</dd></div>
    <div><dt>{labels.dates}</dt><dd>{entry?.dates ?? '—'}</dd></div>
  </dl>
  {entry && <p class="pd-sum">{entry.summary}</p>}
  {!entry && <p class="stamp pd-stamp"><span>{labels.reserved}</span><span>{labels.inPrep}</span></p>}
</Tag>

<style>
  .pd {
    position: relative; display: grid; gap: 12px; align-content: start; padding: 16px;
    border: var(--fio) solid var(--rule); background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: inherit; text-decoration: none; transition: border-color 0.2s;
  }
  .pd:hover, .pd:focus-visible { border-color: var(--draw); }
  .pd-top { display: flex; justify-content: space-between; align-items: center; min-height: 24px; }
  .pd svg { width: 100%; height: auto; }
  .pd--empty svg { opacity: 0.62; }
  .pd-block { margin: 0; display: grid; grid-template-columns: 1fr 1fr; border: var(--fio) solid var(--rule); }
  .pd-block > div { padding: 6px 10px; min-width: 0; }
  .pd-block > div + div { border-left: var(--fio) solid var(--rule); }
  .pd-block .pd-wide { grid-column: 1 / -1; border-bottom: var(--fio) solid var(--rule); }
  .pd-block .pd-wide + div { border-left: 0; }
  .pd-block dt { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .pd-block dd { margin: 1px 0 0; font-family: var(--font-mono); font-size: 13px; overflow-wrap: anywhere; }
  .pd-block .pd-title { font-family: var(--font-serif); font-weight: 600; font-size: 22px; line-height: 1.2; }
  .pd-sum { font-size: 15px; color: var(--muted); }
  .pd-stamp { position: absolute; right: 18px; top: 86px; background: var(--bg); text-align: center; }
  .pd--large .pd-block .pd-title { font-size: 30px; }

  /* inspect mode: dimensions draw in on hover; always drawn where there is no hover */
  .dim path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .dim-v { opacity: 1; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pd:not(.pd--large) .dim path { stroke-dashoffset: 1; transition: stroke-dashoffset 0.5s ease; }
    .pd:not(.pd--large) .dim-v { opacity: 0; transition: opacity 0.3s ease; }
    .pd:hover .dim path, .pd:focus-visible .dim path, .pd:focus-within .dim path { stroke-dashoffset: 0; }
    .pd:hover .dim-v, .pd:focus-visible .dim-v, .pd:focus-within .dim-v { opacity: 1; }
    .pd .dim:nth-of-type(2) path, .pd .dim:nth-of-type(2) .dim-v { transition-delay: 0.12s; }
    .pd .dim:nth-of-type(3) path, .pd .dim:nth-of-type(3) .dim-v { transition-delay: 0.24s; }
  }
</style>
