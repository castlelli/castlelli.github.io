---
// Selected work: each project as a short paper, a figure plate and its abstract.
import { getCollection } from 'astro:content';
import Figure from './Figure.astro';
import Arrow from './Arrow.astro';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const w = t.work;
const entries = (await getCollection('work', (e) => e.data.lang === t.lang)).sort((a, b) => a.data.order - b.data.order);
const base = t.lang === 'en' ? '/work/' : '/pt/work/';
const caption = (fig?: 'phase' | 'paga') => (fig ? w.figs[fig].caption : '');
---
<section id="work" class="section work" aria-labelledby="work-h">
  <div class="wrap">
    <header class="sec-head">
      <h2 class="head" id="work-h"><span class="n">I</span>{w.title}</h2>
      <p>{w.lead}</p>
    </header>

    <div class="papers">
      {entries.map((e, i) => {
        const d = e.data;
        const href = `${base}${d.slug}/`;
        return (
          <article class:list={['paper', { 'paper--flip': i % 2 === 1 }]}>
            <figure class="paper-fig">
              <a class="plate paper-plate" href={href} tabindex="-1" aria-hidden="true" data-plate style={`view-transition-name: plate-${d.slug}`}><span class="plate-light" aria-hidden="true"></span><Figure t={t} figure={d.figure} /></a>
              {d.figure && <figcaption class="figcap"><b>{t.ui.fig} {i + 1}.</b> {caption(d.figure)}</figcaption>}
            </figure>
            <div class="paper-text">
              <h3 class="paper-t"><a href={href}>{d.title}</a></h3>
              <p class="paper-sum">{d.summary}</p>
              <dl class="paper-meta">
                <div><dt>{w.role}</dt><dd>{d.role}</dd></div>
                <div><dt>{w.dates}</dt><dd>{d.dates}</dd></div>
                {d.dims.map((m) => <div><dt>{m.label}</dt><dd>{m.value} {m.unit}</dd></div>)}
              </dl>
              <a class="go" href={href}>{t.hero.open} <span class="vh">{d.title}</span> <Arrow /></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .papers { display: grid; gap: clamp(72px, 9vw, 136px); }
  .paper { display: grid; gap: 32px; align-items: center; }
  .paper-fig { min-width: 0; }
  .paper-plate {
    display: block; position: relative; padding: clamp(20px, 3.6vw, 52px); text-decoration: none; overflow: hidden;
    transform: perspective(1400px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .plate-light { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.4s; background: radial-gradient(520px circle at var(--lx, 50%) var(--ly, 50%), rgba(243, 241, 234, 0.12), transparent 60%); }
  .paper-plate:hover .plate-light { opacity: 1; }
  /* the plate wipes open when it scrolls in */
  :global(.js) .paper-plate.pending { clip-path: inset(0 0 100% 0); }
  .paper-plate.run { animation: wipe 1.1s cubic-bezier(0.76, 0, 0.24, 1) both; }
  @keyframes wipe { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  .paper-text { display: grid; gap: 18px; justify-items: start; align-content: center; min-width: 0; max-width: 46ch; }
  .paper-t { font-weight: 400; font-size: clamp(30px, 3vw, 40px); line-height: 1.1; letter-spacing: -0.012em; text-wrap: balance; }
  .paper-t a { text-decoration: none; }
  .paper-t a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.14em; }
  .paper-sum { font-style: italic; color: var(--muted); }
  .paper-meta { display: flex; flex-wrap: wrap; gap: 8px 32px; font-family: var(--font-sans); font-size: 15px; padding-top: 14px; border-top: 1px solid var(--rule); width: 100%; }
  .paper-meta dt { color: var(--muted); font-size: 13px; }
  .paper-meta dt::first-letter { text-transform: uppercase; }
  .go { margin-top: 8px; }

  @media (min-width: 960px) {
    .paper { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(48px, 6vw, 96px); }
    .paper--flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); }
    .paper--flip .paper-fig { order: 2; }
  }
</style>

<script>
  import '../scripts/plates.ts';
</script>
