---
// FIG. 3: five blueprints, one line from each, meeting at a datum.
import type { Dict } from '../i18n/en';
import Monogram from './Monogram.astro';
import Poli from './axes/Poli.astro';
import Icb from './axes/Icb.astro';
import Embedded from './axes/Embedded.astro';
import Edge from './axes/Edge.astro';
import Health from './axes/Health.astro';

interface Props { t: Dict }
const { t } = Astro.props;
const a = t.axes;
const drawings = { poli: Poli, icb: Icb, embedded: Embedded, edge: Edge, health: Health } as const;
type Id = keyof typeof drawings;
---
<section id="axes" data-sheet="axes" class="sheet">
  <div class="wrap">
    <header class="sheet-head" data-reveal>
      <p class="legend sheet-no">{t.ui.sheet} 03</p>
      <h2 class="titulo">{a.title}</h2>
    </header>

    <figure class="axes" data-axes data-dec={t.dec} data-quant={JSON.stringify(a.quant)}>
      <div class="ax-stage" data-stage>
        <svg class="ax-lines" data-lines aria-hidden="true">
          {a.items.map((it) => (
            <g data-line={it.id}>
              <path class="ax-line" d="" />
              <path class="ax-pulse" pathLength="1" d="" />
            </g>
          ))}
        </svg>

        {a.items.map((it) => {
          const Drawing = drawings[it.id as Id];
          return (
            <article class={`ax ax--${it.id}`} data-ax={it.id}>
              <header class="ax-head">
                <span class="legend">{it.tag}</span>
                <button type="button" class="ax-name" data-select aria-pressed="false">
                  <b>{it.name}</b><span>{it.sub}</span>
                </button>
              </header>
              <div class="ax-draw" role="img" aria-label={it.alt}><Drawing /></div>
              <div class="ax-ctl">
                {(it.id === 'poli' || it.id === 'icb' || it.id === 'embedded') && (
                  <div class="ax-seg" role="group">
                    <button type="button" class="btn btn--sm" data-view="a" aria-pressed="true">{it.toggle[0]}</button>
                    <button type="button" class="btn btn--sm" data-view="b" aria-pressed="false">{it.toggle[1]}</button>
                  </div>
                )}
                {it.id === 'edge' && (
                  <label class="ax-bits">
                    <span class="legend">{it.toggle[0]}</span>
                    <input type="range" min="1" max="8" step="1" value="3" data-bits />
                    <output class="mono" data-bits-out>3 bit</output>
                  </label>
                )}
                {it.id === 'health' && (
                  <button type="button" class="btn btn--sm" data-run aria-pressed="false" data-on={it.toggle[1]} data-off={it.toggle[0]}>{it.toggle[0]}</button>
                )}
              </div>
            </article>
          );
        })}

        <div class="cota ax-cota lyr-dim" aria-hidden="true"><i></i><i></i><span>{a.cota}</span></div>

        <div class="ax-datum" data-datum>
          <div class="ax-datum-mark"><svg viewBox="-60 -60 120 120" aria-hidden="true">
            <path class="dw-soft" d="M-56 0H56M0 -56V56" />
            <circle class="dw-heavy dw-fill" r="26" />
            <path class="ax-datum-q" d="M0 0V-26A26 26 0 0 1 26 0ZM0 0V26A26 26 0 0 1 -26 0Z" />
            <circle class="dw" r="38" stroke-dasharray="3 5" />
          </svg></div>
          <p class="ax-here"><span class="ax-here-mono"><Monogram /></span><b>{a.here}</b></p>
          <p class="legend">{a.hereNote} · 0, 0</p>
        </div>
      </div>

      <div class="panel ax-spec" aria-live="polite">
        <p class="ax-spec-empty" data-spec-empty>{a.select}</p>
        {a.items.map((it) => (
          <div class="ax-spec-item" data-spec={it.id}>
            <p class="legend">{it.tag} · {it.sub}</p>
            <h3>{it.name}</h3>
            <p>{it.text}</p>
            <p class="ax-spec-status"><span class="legend">{a.status}</span> <span class:list={['tag', { 'tag--pending': it.id === 'embedded' || it.id === 'edge' }]}>{it.status}</span></p>
          </div>
        ))}
      </div>

      <figcaption class="fig-cap"><b>{t.ui.fig} 2</b><span class="legend">{a.figTitle}</span></figcaption>
    </figure>
  </div>
</section>

<script>
  import '../scripts/fig3.ts';
</script>

<style is:global>
  .axes { margin: 0; display: grid; gap: 28px; }
  .ax-stage { position: relative; display: grid; gap: 22px; grid-template-columns: minmax(0, 1fr); padding-left: 26px; }
  .ax-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .ax-line { fill: none; stroke: var(--draw-soft); stroke-width: 1.5; stroke-linejoin: miter; transition: stroke 0.2s; }
  .ax-pulse { fill: none; stroke: var(--hot); stroke-width: 3; stroke-dasharray: 0.07 1; stroke-dashoffset: 1.07; opacity: 0; }
  [data-line].on .ax-line { stroke: var(--hot); stroke-width: 2; }
  [data-line].on .ax-pulse { opacity: 1; animation: ax-pulse 1.6s linear infinite; }
  @keyframes ax-pulse { to { stroke-dashoffset: 0; } }

  .ax {
    position: relative; z-index: 1; display: grid; gap: 10px; align-content: start; padding: 14px;
    border: var(--fio) solid var(--rule); background: var(--bg); cursor: pointer;
    transition: border-color 0.2s, opacity 0.25s;
  }
  .ax.on { border-color: var(--hot); box-shadow: inset 0 0 0 1px var(--hot); }
  .ax-stage.has-sel .ax:not(.on) { opacity: 0.72; }
  .ax-stage.has-sel .ax:not(.on):hover { opacity: 0.9; }
  .ax-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-direction: row-reverse; }
  .ax-name { display: grid; text-align: left; gap: 1px; }
  .ax-name b { font-family: var(--font-serif); font-weight: 600; font-size: 22px; line-height: 1.15; }
  .ax-name span { font-size: 13px; color: var(--muted); }
  .ax-draw svg { width: 100%; height: auto; }
  .ax-ctl { min-height: 32px; display: flex; align-items: center; }
  .ax-seg { display: flex; }
  .ax-seg .btn + .btn { border-left: 0; }
  .ax-bits { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 12px; align-items: center; width: 100%; }
  .ax-bits output { grid-column: 1 / -1; font-size: 12px; color: var(--muted); }

  /* detail layer: shown on the selected drawing */
  .ax-detail { transition: opacity 0.3s; }
  .js .ax:not(.on) .ax-detail { opacity: 0; }

  /* two-view drawings */
  .ax-view--b { display: none; }
  .ax.is-alt .ax-view--a { display: none; }
  .ax.is-alt .ax-view--b { display: inline; }

  /* embedded: exploded view */
  .x-part, .x-lab-mcu, .x-small { transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .x-ghost, .x-proj { opacity: 0; transition: opacity 0.4s; }
  .ax.is-alt .x-ghost, .ax.is-alt .x-proj { opacity: 1; }
  .ax.is-alt .x-mcu, .ax.is-alt .x-lab-mcu { transform: translate(22px, -26px); }
  .ax.is-alt .x-usb { transform: translate(-12px, -14px); }
  .ax.is-alt .x-hdr-t { transform: translate(10px, -12px); }
  .ax.is-alt .x-hdr-b { transform: translate(10px, -12px); }
  .ax.is-alt .x-small { transform: translate(6px, -7px); }

  /* edge */
  .e-quant { stroke: var(--hot); }

  /* health */
  .h-tri { fill: var(--bg); stroke: var(--draw); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .h-vent { fill: var(--draw); opacity: 0; }
  .h-pulse { fill: none; stroke: var(--hot); stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-dasharray: 0.06 1; stroke-dashoffset: 1.06; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .ax.run .h-av .h-bar { animation: h-open-first 1.1s steps(1, end) infinite; }
    .ax.run .h-av .h-tri { animation: h-fill-first 1.1s steps(1, end) infinite; }
    .ax.run .h-out .h-bar { animation: h-open-second 1.1s steps(1, end) infinite; }
    .ax.run .h-out .h-tri { animation: h-fill-second 1.1s steps(1, end) infinite; }
    .ax.run .h-vent { animation: h-squeeze 1.1s ease-out infinite; }
    .ax.run .h-pulse { opacity: 1; animation: h-run 3.3s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ax.run .h-out .h-bar { opacity: 0; }
    .ax.run .h-out .h-tri { fill: var(--draw); }
    .ax.run .h-vent { opacity: 0.3; }
    [data-line].on .ax-pulse { animation: none; opacity: 0; }
  }
  @keyframes h-open-first { 0% { opacity: 0; } 55% { opacity: 1; } }
  @keyframes h-fill-first { 0% { fill: var(--draw); } 55% { fill: var(--bg); } }
  @keyframes h-open-second { 0% { opacity: 1; } 55% { opacity: 0; } }
  @keyframes h-fill-second { 0% { fill: var(--bg); } 55% { fill: var(--draw); } }
  @keyframes h-squeeze { 0%, 52% { opacity: 0; } 62% { opacity: 0.38; } 100% { opacity: 0; } }
  @keyframes h-run { to { stroke-dashoffset: 0; } }

  /* cota between the two buildings */
  .ax-cota { align-self: center; }

  /* datum */
  .ax-datum { position: relative; z-index: 2; display: grid; justify-items: center; gap: 6px; padding-block: 8px; text-align: center; }
  .ax-datum-mark { width: 112px; height: 112px; }
  .ax-datum svg { width: 100%; height: 100%; }
  .ax-datum-q { fill: var(--draw); transition: fill 0.4s; }
  .ax-datum.lit .ax-datum-q { fill: var(--hl); }
  .ax-here { display: flex; align-items: center; gap: 10px; }
  .ax-here b { background: var(--hl); color: var(--hl-fg); font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; }
  .ax-here-mono .mono-vc { height: 26px; width: auto; }

  /* spec panel */
  /* the inspector docks to the bottom of the screen while the figure is in view */
  .ax-spec { max-width: 820px; min-height: 150px; position: sticky; bottom: 12px; z-index: 3; padding: 18px 20px; max-height: 44vh; overflow-y: auto; box-shadow: 0 0 0 1.5px var(--panel-fg); }
  @media (min-width: 900px) { .ax-spec { bottom: 40px; padding: 24px 32px; } }
  .ax-spec h3 { font-family: var(--font-serif); font-weight: 600; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.15; margin: 2px 0 6px; }
  .ax-spec-item p { font-size: 15px; }
  @media (min-width: 900px) { .ax-spec-item p { font-size: 16px; } }
  .ax-spec-item + .ax-spec-item { margin-top: 28px; }
  .ax-spec-status { margin-top: 14px; display: flex; gap: 10px; align-items: center; }
  .ax-spec-empty { display: none; color: var(--muted); }
  .js .ax-spec-empty { display: block; }
  .js .ax-spec-item { display: none; margin-top: 0; }
  .js .ax-spec.has-sel .ax-spec-empty { display: none; }
  .js .ax-spec-item.on { display: block; }

  @media (min-width: 1000px) {
    .ax-stage {
      padding-left: 0; gap: 0 clamp(28px, 4vw, 64px);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas: "poli cota icb" ". datum ." "embedded edge health";
      grid-template-rows: auto 250px auto;
    }
    .ax--poli { grid-area: poli; } .ax--icb { grid-area: icb; }
    .ax--embedded { grid-area: embedded; } .ax--edge { grid-area: edge; } .ax--health { grid-area: health; }
    .ax-cota { grid-area: cota; margin-inline: calc(clamp(28px, 4vw, 64px) * -1 + 8px); }
    .ax-datum { grid-area: datum; align-self: center; }
  }
  @media (max-width: 999px) {
    .ax-cota { width: 60%; justify-self: center; }
    .ax--poli { order: 1; } .ax-cota { order: 2; } .ax--icb { order: 3; }
    .ax--embedded { order: 4; } .ax--edge { order: 5; } .ax--health { order: 6; } .ax-datum { order: 7; }
  }
</style>
